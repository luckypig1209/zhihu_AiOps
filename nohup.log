root@zhihuops:/data/zhihu/data/zhihu-proxy/conf.d# cat front.conf 
server {
    listen 58080;

    server_name localhost;

    # 前端资源所在路径
    root /etc/nginx/dist;
 
    location / {
        root /etc/nginx/dist;
        try_files $uri $uri/ /index.html;
        # index index.html index.htm;
    }

    location /download {
       charset utf-8,gbk;
       autoindex on;
       autoindex_exact_size off;
       autoindex_localtime on;
       root /etc/html;
    }

    location /shell {
       charset utf-8,gbk;
       autoindex on;
       autoindex_exact_size off;
       autoindex_localtime on;
       root /etc/html;
    }

    # AI服务代理 - 优化超时配置
    location /admin-api/api/v1/ai/ {
        proxy_pass http://zhihu-ai:8000/api/v1/ai/;
        proxy_read_timeout 300s;      # 读取超时改为5分钟，适应复杂AI查询
        proxy_connect_timeout 30s;    # 连接超时
        proxy_send_timeout 300s;      # 发送超时改为5分钟
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS配置
        add_header 'Access-Control-Allow-Origin' '*';
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';
            add_header 'Content-Length' 0;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            return 204;
        }
    }

    # 资产管理API代理
    location /admin-api/api/v1/assets/ {
        proxy_pass http://zhihu-ai:8000/api/v1/assets/;
        proxy_read_timeout 30s;
        proxy_connect_timeout 10s;
        proxy_send_timeout 30s;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;

        # CORS配置
        add_header 'Access-Control-Allow-Origin' '*';
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';

        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';
            add_header 'Content-Length' 0;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            return 204;
        }
    }

    location /api/ai/ {
        proxy_pass http://zhihu-ai:8000/api/v1/;
        proxy_read_timeout 300s;      # 读取超时改为5分钟，适应复杂AI查询
        proxy_connect_timeout 30s;    # 连接超时
        proxy_send_timeout 300s;      # 发送超时改为5分钟
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        
        # CORS配置
        add_header 'Access-Control-Allow-Origin' '*';
        add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
        add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';
        
        # 处理OPTIONS预检请求
        if ($request_method = 'OPTIONS') {
            add_header 'Access-Control-Allow-Origin' '*';
            add_header 'Access-Control-Allow-Methods' 'GET, POST, OPTIONS';
            add_header 'Access-Control-Allow-Headers' 'Content-Type, Authorization';
            add_header 'Content-Length' 0;
            add_header 'Content-Type' 'text/plain charset=UTF-8';
            return 204;
        }
    }

    # 后端代理
    location /admin-api {
        proxy_pass http://zhihu-server:48080/admin-api;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    location = /screen {
        return 301 /screen/;
    }

    location /screen/ {
        proxy_pass http://127.0.0.1:18100/;
        proxy_redirect / /screen/;

        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # 错误页面（根据需要自定义）
    error_page 404 /404.html;
    error_page 500 502 503 504 /50x.html;

    location = /50x.html {
        root /usr/share/nginx/html;
    }
}

