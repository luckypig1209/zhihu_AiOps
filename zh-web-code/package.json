  "scripts": {
    "local": "vue-cli-service serve --mode local",
    "dev": "vue-cli-service serve --mode dev",
    "prod": "vue-cli-service serve --mode prod",
    "dev87": "vue-cli-service serve --mode dev87",
    "dev58": "vue-cli-service serve --mode dev58",
    "dev211": "vue-cli-service serve --mode jiangsuyibaoju211",
    "dev210": "vue-cli-service serve --mode jiangsuyibaoju210",
    "front": "vue-cli-service serve --mode front",
    "build": "vue-cli-service build --mode dev",
    "build:prod": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode prod",
    "build:stage": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode stage",
    "build:dev": "NODE_OPTIONS=--openssl-legacy-provider vue-cli-service build --mode dev",
