    "build:jiangsuyibaoju210": "vue-cli-service build --mode jiangsuyibaoju210",
    "build:static": "vue-cli-service build --mode static",
    "preview": "node build/index.js --preview",
    "lint": "eslint --ext .js,.vue src",
    "clean": "rimraf node_modules",
    "ws:server": "node websocket-bridge/server.js",
    "ws:claude": "node websocket-bridge/claude-connector.js",
    "ws:dev": "concurrently \"npm run ws:server\" \"npm run ws:claude\""
  },
