# 开发环境配置
ENV = 'development'

# 页面标题
# VUE_APP_TITLE = 智护平台

# 智护平台/开发环境
# VUE_APP_BASE_API = 'http://10.2.8.87:28888'
# VUE_APP_BASE_API = 'http://132.254.87.62:28090' //62 
VUE_APP_BASE_API = 'http://117.89.88.210:58080'

# AI功能配置
VUE_APP_AI_API_BASE = 'http://192.168.0.193:18000/api/v1'
VUE_APP_AI_MOCK = 'false'

# 路由懒加载
VUE_CLI_BABEL_TRANSPILE_MODULES = true

# 多租户的开关
VUE_APP_TENANT_ENABLE = false

# 验证码的开关
VUE_APP_CAPTCHA_ENABLE = true

# 文档的开关
VUE_APP_DOC_ENABLE = true

# 百度统计
VUE_APP_BAIDU_CODE = fadc1bd5db1a1d6f581df60a1807f8ab

# 默认语言配置
VUE_APP_DEFAULT_LOCALE = 'en'

# WebSocket Bridge Server 配置
# 本地开发使用 localhost:9999（Docker 容器映射到本地）
VUE_APP_WS_URL = 'ws://localhost:9999'

# Docker 容器端口映射检查命令：
# docker port zhihu-ai-bridge
# 预期输出: 0.0.0.0:9999->9999/tcp
#
# 如果 WebSocket 连接失败，检查：
# 1. 容器是否运行: docker ps | grep zhihu-ai-bridge
# 2. 端口映射是否正确: docker port zhihu-ai-bridge
# 3. 容器内服务是否监听 0.0.0.0: docker exec zhihu-ai-bridge netstat -tlnp | grep 9999
# docker run -d --name zhihu-ai-bridge -p 0.0.0.0:9999:9999 aiops-ai-bridge
#
# 如果服务器 WebSocket 有 Nginx 代理，使用：
# VUE_APP_WS_URL = 'ws://117.89.88.210/ws/'
