# 生产环境配置
NODE_ENV = 'production'

# 页面标题
# VUE_APP_TITLE = 智护平台

# 智护平台/生产环境
VUE_APP_BASE_API = '/prod-api'

# 根据服务器或域名修改
PUBLIC_PATH = '/'
# 二级部署路径
VUE_APP_APP_NAME ='yudao-admin'

# 多租户的开关
VUE_APP_TENANT_ENABLE = true

# 验证码的开关
VUE_APP_CAPTCHA_ENABLE = true

# 文档的开关
VUE_APP_DOC_ENABLE = false

# 百度统计
VUE_APP_BAIDU_CODE = fadc1bd5db1a1d6f581df60a1807f8ab

# 默认语言配置
VUE_APP_DEFAULT_LOCALE = 'en'

# WebSocket URL (生产环境 - 通过Nginx代理)
# 使用相对路径，让浏览器自动使用当前host
VUE_APP_WS_URL=ws://117.89.88.204:58080/ws/
